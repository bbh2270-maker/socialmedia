# ==========================================
# AI Provider API Keys
# ==========================================
# Get Gemini key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Get Groq key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Get OpenRouter key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ==========================================
# Facebook Graph API Credentials
# ==========================================
# Numeric Page ID from your Facebook Page 'About' section or Graph Explorer
FB_PAGE_ID=your_facebook_page_id_here

# Long-lived Page Access Token with pages_manage_posts, pages_read_engagement
FB_PAGE_ACCESS_TOKEN=your_long_lived_facebook_page_access_token_here
